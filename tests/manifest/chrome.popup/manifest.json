{
  "version": "1.0.0",
  "author": "René Horn",
  "name": "Station Recorder",
  "short_name": "station-recorder",
  "description": "Radio downloader with blacklists. Vote a station. Local database URL search. Get updates from radio-browser.info database.",
  "manifest_version": 3,
  "homepage_url": "https://github.com/44xtc44/station-recorder.git",
  "action": {
    "default_icon": {
      "16": "/static/images/default_icon.svg",
      "32": "/static/images/default_icon.svg",
      "48": "/static/images/default_icon.svg",
      "96": "/static/images/default_icon.svg",
      "192": "/static/images/default_icon.svg",
      "384": "/static/images/default_icon.svg",
      "768": "/static/images/default_icon.svg",
      "1536": "/static/images/default_icon.svg"
    },
    "default_popup": "/static/addon.html"
  },
  "background": {
    "service_worker": "/static/js/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": ["file://*/*", "<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "content_scripts": [
    {
      "js": [
        "/static/js/database/dbLoader.mjs",
        "/static/js/assets/shaka-player.compiled.js"
      ],
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_end",
      "css": ["/static/css/style.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["/static/addon.html","/static/js/database/dbLoader.mjs"],
      "matches": ["<all_urls>"]
    }
  ]
}
